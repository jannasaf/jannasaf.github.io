---
import { cleanHtml, portfolio } from "../data/portfolio";
---

<footer class="site-footer">
  <div class="shell site-footer__inner">
    <div class="rich-text footer-copy" set:html={cleanHtml(portfolio.site.footer)} />
    <div class="footer-meta">
      <a
        class="social-link"
        href={portfolio.site.linkedin}
        target="_blank"
        rel="noreferrer"
        aria-label="Janna Safran on LinkedIn"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M6.5 8.2H3.3V20h3.2V8.2ZM4.9 3A1.9 1.9 0 1 0 5 6.8 1.9 1.9 0 0 0 5 3Zm8.3 5.2H10V20h3.2v-5.8c0-1.5.3-3 2.2-3 1.9 0 1.9 1.8 1.9 3.1V20h3.2v-6.4c0-3.1-.7-5.6-4.4-5.6-1.8 0-3 1-3.5 1.9h-.1V8.2h.7Z"/>
        </svg>
      </a>
      <p>© {new Date().getFullYear()} Janna Safran</p>
    </div>
  </div>
</footer>
